# Required: the bridge and HolmesGPT both call Anthropic.
ANTHROPIC_API_KEY=

# Override the model the orchestrator / bridge calls.
# VERIFIER_MODEL=claude-sonnet-4-6

# Required: this demo runs the candidate against a real cluster via mirrord.
# Point mirrord at the target deployment and namespace in your cluster.
MIRRORD_TARGET=deploy/checkout
MIRRORD_NAMESPACE=verifier-poc
# MIRRORD_BIN=mirrord

# Required only if you wire up DatadogEventPoster.
# DATADOG_API_KEY=

# Required only if you wire up GitHubPRCommentPoster.
# GITHUB_TOKEN=
